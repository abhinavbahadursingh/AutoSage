# AutoSage Backend — Phase 1 environment template.
# Copy to backend/.env and adjust. Every variable has a dev default in
# app/core/config.py, so the service also boots with no .env at all.

APP_ENV=development
APP_SECRET_KEY=change-this-in-production-super-secret-key-32chars
DEBUG=True
LOG_LEVEL=INFO

# PostgreSQL + pgvector (async driver for the app; Alembic derives sync URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autosage
# Managed Postgres (e.g. Supabase, direct connection) requires TLS — append
# ?sslmode=require (the app translates it to asyncpg connect_args; Alembic
# passes it to libpq natively):
# DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
# Verbose SQL statement echo (debug only — very noisy).
SQL_ECHO=False

REDIS_URL=redis://localhost:6379/0
# JSON array (complex fields are JSON-decoded; comma string also works via real env vars)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=autosage_default
MLFLOW_ARTIFACT_ROOT=./mlflow_artifacts

# --- Supabase (PostgreSQL + Auth + Storage) ---
# Supabase project URL (e.g. https://xxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Supabase service role key (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Supabase anon key for client
SUPABASE_ANON_KEY=your-anon-key
# Storage bucket name (must exist in Supabase Storage)
SUPABASE_STORAGE_BUCKET=autosage-files

# --- Phase 5: Celery + Redis (async experiment execution) ---
# Empty = fall back to REDIS_URL. Separate DB indexes isolate broker/results.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# CELERY_EXPERIMENT_QUEUE=experiments
# CELERY_TASK_ALWAYS_EAGER=False  # True = run tasks inline, no broker (tests)
# CELERY_TASK_TIME_LIMIT=1800
# CELERY_TASK_SOFT_TIME_LIMIT=1500
# CELERY_RETRY_BACKOFF_BASE=60
# CELERY_RETRY_BACKOFF_MAX=3600

# --- Phase 6: LangGraph workflow ---
# WORKFLOW_MAX_ATTEMPTS=2

# --- Phase 7/8: Specialized agents + LLM layer ---
# Provider keys (leave empty to skip that provider; agents fall back to
# heuristics when no provider is configured and LLM_ALLOW_HEURISTIC_FALLBACK).
# GROQ_API_KEY=gsk_your_groq_api_key_here
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
# HUGGINGFACE_API_TOKEN=hf_your_huggingface_token_here
# DEFAULT_FAST_MODEL=groq/llama-3.1-8b-instant
# DEFAULT_REASONING_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# DEFAULT_MODEL=
# LLM_FALLBACK_ORDER=["groq","openrouter","huggingface"]
# LLM_TIMEOUT_SECONDS=30
# LLM_RATE_LIMIT_WAIT_SECONDS=1
# LLM_ALLOW_HEURISTIC_FALLBACK=True

# --- Phase 2: Authentication (Supabase Auth) ---
# Supabase Auth URL (same as SUPABASE_URL)
# Supabase Auth uses RS256 JWTs with JWKS at /auth/v1/.well-known/jwks.json
JWT_ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Dev-only token minter (POST /api/v1/auth/dev-token). Set False in prod.
AUTH_DEV_TOKEN_ENABLED=True
