# FastAPI backend base URL (all frontend API calls go through lib/api.ts)
# Use the Vite dev proxy path to avoid CORS (proxy targets VITE_BACKEND_ORIGIN).
VITE_API_BASE_URL=/api/v1
# Direct backend origin used by the Vite dev server proxy.
# In production this is the Render backend origin, e.g.
# VITE_BACKEND_ORIGIN=https://autosage-1.onrender.com
# (lib/api.ts derives the API base as <origin>/api/v1 when
# VITE_API_BASE_URL is unset.)
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
# WebSocket base for experiment streams. Production, e.g.
# VITE_WS_BASE_URL=wss://autosage-1.onrender.com
# (a bare origin gains the /api/v1 prefix automatically).
VITE_WS_BASE_URL=ws://localhost:8000
# Local-dev token minter (POST /auth/dev-token). The client only calls it
# on localhost or when this is 'true' — never in production builds served
# from another host (the production backend answers 404 there by design).
# VITE_ALLOW_DEV_TOKEN=true
# Production auth (Supabase Auth — sign-in/sign-up + Demo guest login).
# When set, the Login page offers email/password auth and Demo Login uses
# anonymous sign-in; tokens are verified by the backend via JWKS.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
