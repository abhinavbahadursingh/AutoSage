# AutoSage Root Environment Configuration

# Application
APP_ENV=development
APP_SECRET_KEY=change-this-in-production-super-secret-key-32chars
DEBUG=True

# Database (Supabase PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/autosage
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis (Celery Broker & Event Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# MLflow Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=autosage_default

# LLM Providers (Free / Accessible APIs)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
HUGGINGFACE_API_TOKEN=hf_your_huggingface_token_here

# Default Models
DEFAULT_FAST_MODEL=groq/llama-3.1-8b-instant
DEFAULT_REASONING_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct

# Docker Sandbox Settings
DOCKER_SANDBOX_IMAGE=autosage-runner:latest
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_MEMORY=4g
SANDBOX_CPU_LIMIT=2.0

# Storage Paths
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=autosage-backend
